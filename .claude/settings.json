{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git stash clear *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(rsync *)",
      "Bash(sendmail *)",
      "Bash(mailx *)",
      "Bash(msmtp *)",
      "Bash(twine upload *)",
      "Bash(cargo publish *)",
      "Bash(docker push *)",
      "Bash(terraform apply *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(wrangler *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*credential*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa*)"
    ]
  }
}
