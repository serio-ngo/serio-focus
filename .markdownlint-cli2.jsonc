{
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "**/node_modules/**", ".claude/**", "audit/**"],
  "config": {
    // Prose wraps at 110; a hard limit fights tables.
    "line-length": false,
    "no-inline-html": false,
    "no-duplicate-heading": { "siblings_only": true },
    // Skills, agents and the PR template carry their title in frontmatter, not an h1.
    "first-line-heading": false,
    // Compact table separators (|---|---|) are the house style across every document.
    "table-column-style": false
  }
}
