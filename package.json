{
  "name": "serio-focus",
  "version": "1.21.0",
  "description": "Serio NGO's ADHD/AuDHD focus tool for Claude Code and Codex: optional read, direct-agent and shell guards. No model calls, API keys or runtime dependencies.",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/serio-ngo/serio-focus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/serio-ngo/serio-focus.git"
  },
  "bugs": {
    "url": "https://github.com/serio-ngo/serio-focus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "verify": "node --test",
    "prove": "node tooling/cli/serio.mjs prove",
    "setup": "node tooling/cli/serio.mjs setup",
    "sync": "node tooling/cli/serio.mjs sync",
    "install:plugin": "node tooling/cli/serio.mjs install",
    "upkeep": "node tooling/cli/serio.mjs upkeep",
    "upkeep:check": "node tooling/cli/serio.mjs upkeep --check",
    "doctor": "node tooling/cli/serio.mjs doctor",
    "release": "node tooling/cli/serio.mjs release",
    "benchmark": "node tooling/benchmark/benchmark.mjs",
    "benchmark:eval": "node tooling/benchmark/benchmark.mjs --eval",
    "benchmark:compare": "node tooling/benchmark/benchmark.mjs --eval --compare --write",
    "benchmark:replay": "node tooling/benchmark/benchmark.mjs --replay --write"
  }
}
